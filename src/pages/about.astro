---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SKILLS } from '../data/site';

// 生成柱状图数据：以 level 为峰值的 10 根小柱
const bars = (level: number) =>
  Array.from({ length: 10 }, (_, i) => Math.round(level * Math.min(1, (i + 1) / 10) * 6 + 2));
---

<BaseLayout title={`关于我 — ${SITE.name}`}>
  <section class="container page-hero">
    <h1 class="page-title rise rise-1">About<br />me<span class="dot-end">.</span></h1>
  </section>

  <section class="container about-grid">
    <!-- 左列：自述 + 档案卡 -->
    <div class="about-left rise rise-2">
      <div class="intro">
        <p>
          我是 {SITE.nameZh}（{SITE.name}），一名{SITE.roleZh}，研究方向为船舶与海洋工程交叉的智能化方法。
          比起只讨论概念，我更喜欢把新方法放进真实的研究与工程问题里，用能运行的实验和结果验证它。
        </p>
        <p>
          目前关注大模型安全与护栏、Mixture of Experts 等深度学习机制，以及计算机图形学中的参数化曲线建模。
          同时维护一些开源的实验代码与交互式 demo，相信 "build in public" 对科研同样适用。
        </p>
        <p>
          这里是我的研究地图与 build log：记录有效的方法、真实的踩坑和正在发生的前沿变化。
        </p>
      </div>

      <!-- 档案卡 -->
      <div class="profile-card">
        <div class="pc-main">
          <div class="pc-col mono">
            <p class="pc-head">▣ {SITE.profile.id}</p>
            <p>NAME : {SITE.profile.name}</p>
            <p>ROLE : {SITE.profile.role}</p>
            <p>STATUS : {SITE.profile.status}</p>
            <p class="pc-gap">▣ SPEC</p>
            <p>EDU : {SITE.profile.edu}</p>
            <p>LANG : {SITE.profile.lang}</p>
            <p class="pc-gap">▣ VER</p>
            <p>{SITE.profile.ver}</p>
            <p>{SITE.profile.est}</p>
          </div>
          <div class="pc-center display">W<span>.</span></div>
          <div class="pc-col mono pc-right">
            <p class="pc-head">CATEGORY</p>
            <p>: AI / LLM</p>
            <p>: DEEP LEARNING</p>
            <p>: GRAPHICS</p>
            <p class="pc-gap">FOCUS ▣</p>
            {SITE.profile.focus.map((f) => <p>: {f}</p>)}
            <p class="pc-gap">METHODOLOGY ▣</p>
            <p>REAL PROBLEMS</p>
            <p>REAL EXPERIMENTS</p>
          </div>
        </div>
        <span class="crosshair pc-c tl"></span>
        <span class="crosshair pc-c br"></span>
      </div>
    </div>

    <!-- 右列：技能信号台 -->
    <div class="about-right rise rise-3">
      <div class="signal-head">
        <h2 class="signal-title">信号台</h2>
        <p class="mono">SKILL MATRIX · <span class="live">● LIVE</span></p>
      </div>

      <ul class="signal-list">
        {
          SKILLS.map((s) => (
            <li class="signal-row">
              <div class="signal-name">
                <strong>{s.name}</strong>
                <span class="mono note">{s.note}</span>
              </div>
              <div class="signal-bars" aria-hidden="true">
                {bars(s.level).map((h) => (
                  <span style={`height:${h}px`} />
                ))}
              </div>
              <span class="mono status">{s.status}</span>
              <span class="mono years">{s.years}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 90px;
    align-items: start;
    padding-top: 30px;
  }

  .intro p {
    font-size: 17px;
    color: var(--ink-soft);
    margin-bottom: 1.2em;
    max-width: 560px;
  }

  /* ----- 档案卡 ----- */
  .profile-card {
    margin-top: 56px;
    border: 1px solid var(--line-strong);
    background: rgba(230, 225, 213, 0.55);
    padding: 34px 30px;
    position: relative;
  }

  .pc-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .pc-col {
    line-height: 2;
  }

  .pc-right {
    text-align: right;
  }

  .pc-head {
    color: var(--ink);
    font-weight: 500;
  }

  .pc-gap {
    margin-top: 14px;
    color: var(--ink);
  }

  .pc-center {
    font-size: 88px;
    font-weight: 900;
    padding: 0 12px;
  }

  .pc-center span {
    color: var(--accent);
  }

  .pc-c.tl { position: absolute; top: -9px; left: 14px; background: var(--bg); }
  .pc-c.br { position: absolute; bottom: -9px; right: 14px; background: var(--bg); }

  /* ----- 信号台 ----- */
  .signal-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
  }

  .signal-title {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
  }

  .live {
    color: var(--accent);
  }

  .signal-list {
    list-style: none;
  }

  .signal-row {
    display: grid;
    grid-template-columns: minmax(150px, 1.3fr) auto 1fr 52px;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .signal-name strong {
    font-size: 16px;
    display: block;
    line-height: 1.4;
  }

  .signal-name .note {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .signal-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 38px;
  }

  .signal-bars span {
    width: 5px;
    background: var(--accent);
    border-radius: 1px;
    opacity: 0.9;
  }

  .status {
    color: var(--ink-soft);
    text-align: right;
  }

  .years {
    text-align: right;
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .pc-main {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .pc-right {
      text-align: left;
    }

    .pc-center {
      padding: 10px 0;
    }

    .signal-row {
      grid-template-columns: 1fr auto;
    }

    .status {
      display: none;
    }
  }
</style>
