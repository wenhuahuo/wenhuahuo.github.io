---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, STACK } from '../data/site';
---

<BaseLayout title={`关于我 — ${SITE.name}`}>
  <section class="container page-hero">
    <h1 class="page-title rise rise-1">About<br />me<span class="dot-end">.</span></h1>
  </section>

  <section class="container about-grid">
    <!-- 左列：自述 + 档案卡 -->
    <div class="about-left rise rise-2">
      <div class="intro">
        <p>
          我是{SITE.nameZh}，一名{SITE.roleZh}，研究方向为船舶与海洋工程交叉的智能化方法。
          比起只讨论概念，我更喜欢把新方法放进真实的研究与工程问题里，用能运行的实验和结果验证它。
        </p>
        <p>
          目前关注 AI4CAD、AI4CFD 与 AI Agent 工程化等方向，相信深度学习能为传统船舶与海洋工程带来真正可用的工具。
          同时维护开源项目与实验代码，相信 "build in public" 对科研同样适用。
        </p>
        <p>
          这里是我的研究地图与 build log：记录有效的方法、真实的踩坑和正在发生的前沿变化。
        </p>
      </div>

      <!-- 档案卡 -->
      <div class="profile-card">
        <div class="pc-main">
          <div class="pc-col mono">
            <p class="pc-head">▣ {SITE.profile.id}</p>
            <p>NAME : {SITE.profile.name}</p>
            <p>ROLE : {SITE.profile.role}</p>
            <p>STATUS : {SITE.profile.status}</p>
            <p class="pc-gap">▣ SPEC</p>
            <p>EDU : {SITE.profile.edu}</p>
            <p>LANG : {SITE.profile.lang}</p>
            <p class="pc-gap">▣ VER</p>
            <p>{SITE.profile.ver}</p>
            <p>{SITE.profile.est}</p>
          </div>
          <div class="pc-center display">W<span>.</span></div>
          <div class="pc-col mono pc-right">
            <p class="pc-head">CATEGORY ▣</p>
            {SITE.profile.category.map((c) => <p>: {c}</p>)}
            <p class="pc-gap">FOCUS ▣</p>
            {SITE.profile.focus.map((f) => <p>: {f}</p>)}
            <p class="pc-gap">METHODOLOGY ▣</p>
            {SITE.profile.methodology.map((m) => <p>: {m}</p>)}
          </div>
        </div>
        <span class="crosshair pc-c tl"></span>
        <span class="crosshair pc-c br"></span>
      </div>
    </div>

    <!-- 右列：技术栈索引卡 -->
    <div class="about-right rise rise-3">
      <div class="stack-head">
        <h2 class="stack-title">技术栈</h2>
        <p class="mono">TOOLBOX · <span class="live">INDEX / {String(STACK.length).padStart(2, '0')}</span></p>
      </div>

      <div class="stack-grid">
        {
          STACK.map((s, i) => (
            <div class="stack-cell">
              <p class="mono idx">{String(i + 1).padStart(2, '0')}</p>
              <p class="stack-name display">{s.name}</p>
              <p class="mono note">{s.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 90px;
    align-items: start;
    padding-top: 30px;
  }

  .intro p {
    font-size: 17px;
    color: var(--ink-soft);
    margin-bottom: 1.2em;
    max-width: 560px;
  }

  /* ----- 档案卡 ----- */
  .profile-card {
    margin-top: 56px;
    border: 1px solid var(--line-strong);
    background: rgba(230, 225, 213, 0.55);
    padding: 34px 30px;
    position: relative;
  }

  .pc-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .pc-col {
    line-height: 2;
  }

  .pc-right {
    text-align: right;
  }

  .pc-head {
    color: var(--ink);
    font-weight: 500;
  }

  .pc-gap {
    margin-top: 14px;
    color: var(--ink);
  }

  .pc-center {
    font-size: 88px;
    font-weight: 900;
    padding: 0 12px;
  }

  .pc-center span {
    color: var(--accent);
  }

  .pc-c.tl { position: absolute; top: -9px; left: 14px; background: var(--bg); }
  .pc-c.br { position: absolute; bottom: -9px; right: 14px; background: var(--bg); }

  /* ----- 技术栈索引卡 ----- */
  .stack-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
  }

  .stack-title {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
  }

  .live {
    color: var(--accent);
  }

  .stack-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-left: 1px solid var(--line-strong);
    border-top: 1px solid var(--line-strong);
  }

  .stack-cell {
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    padding: 26px 24px 22px;
    position: relative;
    transition: background 0.2s ease;
  }

  .stack-cell:hover {
    background: rgba(37, 99, 235, 0.05);
  }

  .stack-cell .idx {
    color: var(--accent);
    margin-bottom: 14px;
  }

  .stack-name {
    font-size: 21px;
    font-weight: 700;
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .stack-cell .note {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .pc-main {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .pc-right {
      text-align: left;
    }

    .pc-center {
      padding: 10px 0;
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
