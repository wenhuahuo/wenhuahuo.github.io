---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const cards = [
  {
    label: 'EMAIL',
    title: SITE.contact.email,
    sub: '学术交流 / 合作',
    href: `mailto:${SITE.contact.email}`,
    icon: '✉',
  },
  {
    label: 'GITHUB',
    title: SITE.contact.githubUser,
    sub: '开源项目 · 实验代码',
    href: SITE.contact.github,
    icon: '◉',
  },
  ...(SITE.contact.scholar
    ? [
        {
          label: 'GOOGLE SCHOLAR',
          title: SITE.name,
          sub: '论文 · 学术主页',
          href: SITE.contact.scholar,
          icon: '§',
        },
      ]
    : []),
  {
    label: 'WECHAT / 微信',
    title: SITE.contact.wechat,
    sub: '点击复制',
    href: '#',
    icon: '◌',
    copy: true,
  },
];
---

<BaseLayout title={`联系 — ${SITE.name}`}>
  <section class="container talk">
    <p class="mono rise rise-1">—— GET IN TOUCH / 联系 ——</p>
    <h1 class="display talk-title rise rise-2">
      Let's <em>talk</em><span class="dot-end">.</span>
    </h1>
    <p class="talk-sub rise rise-3">
      聊聊大模型安全、深度学习机制、科研工程化，或者一次可能的学术合作。
    </p>
    <p class="mono status-line rise rise-3">
      <span class="accent-dot"></span>博士在读 · 欢迎邮件与学术交流
    </p>
  </section>

  <!-- 关键词行 -->
  <div class="marquee rise rise-4" aria-hidden="true">
    <div class="marquee-inner">
      {
        [0, 1].map(() =>
          SITE.marquee.map((kw) => (
            <>
              <span class="kw">{kw}</span>
              <span class="sep">·</span>
            </>
          ))
        )
      }
    </div>
  </div>

  <!-- 联系卡片网格 -->
  <section class="container grid rise rise-4">
    {
      cards.map((c) => (
        <a
          href={c.href}
          class="card"
          data-copy={c.copy ? c.title : undefined}
        >
          <span class="icon">{c.icon}</span>
          <div class="card-body">
            <p class="mono">{c.label}</p>
            <p class="card-title">{c.title}</p>
            <p class="mono sub">{c.sub}</p>
          </div>
          <span class="arrow">→</span>
        </a>
      ))
    }
  </section>

  <p class="copied mono" id="copied">已复制到剪贴板 ✓</p>
</BaseLayout>

<style>
  .talk {
    text-align: center;
    padding-top: 120px;
  }

  .talk-title {
    font-size: clamp(72px, 12vw, 180px);
    font-weight: 900;
    margin: 20px 0 26px;
  }

  .talk-title em {
    font-style: italic;
    position: relative;
  }

  /* 橙色高亮条 */
  .talk-title::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-54%);
    bottom: 0.04em;
    width: 8.2em;
    height: 0.32em;
    background: var(--accent);
    opacity: 0.75;
    z-index: -1;
  }

  .talk-sub {
    font-size: 18px;
    color: var(--ink-soft);
    margin-bottom: 22px;
  }

  .status-line {
    color: var(--ink-soft);
  }

  /* ----- 关键词滚动行 ----- */
  .marquee {
    margin-top: 100px;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    overflow: hidden;
    padding: 18px 0;
  }

  .marquee-inner {
    display: flex;
    gap: 36px;
    white-space: nowrap;
    animation: scroll 30s linear infinite;
    width: max-content;
  }

  .kw {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
  }

  .sep {
    color: var(--line-strong);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* ----- 卡片 ----- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--line-strong);
    border-top: none;
    max-width: 1100px;
  }

  .card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 34px 36px;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transition: background 0.2s ease;
  }

  .card:hover {
    background: rgba(232, 98, 44, 0.05);
  }

  .card:nth-child(2n) {
    border-right: none;
  }

  .card:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .icon {
    font-size: 22px;
    width: 36px;
    text-align: center;
    flex: none;
  }

  .card-body {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    font-size: 18px;
    margin: 4px 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sub {
    text-transform: none;
  }

  .arrow {
    color: var(--ink-faint);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .card:hover .arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  .copied {
    text-align: center;
    margin-top: 24px;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .copied.show {
    opacity: 1;
  }

  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .card,
    .card:nth-child(2n) {
      border-right: none;
      border-bottom: 1px solid var(--line-strong);
    }

    .card:last-child {
      border-bottom: none;
    }
  }
</style>

<script>
  // 微信卡片点击复制
  const copied = document.getElementById('copied');
  document.querySelectorAll<HTMLAnchorElement>('a[data-copy]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.clipboard?.writeText(el.dataset.copy ?? '').then(() => {
        copied?.classList.add('show');
        setTimeout(() => copied?.classList.remove('show'), 1800);
      });
    });
  });
</script>
