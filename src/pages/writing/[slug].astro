---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title={`${post.data.title} — ${SITE.name}`} description={post.data.description}>
  <article class="container article">
    <a href="/writing" class="mono back">← 返回列表</a>

    <header class="head">
      <p class="mono meta">
        {fmt(post.data.date)}
        {post.data.category && <span class="chip chip-accent">{post.data.category}</span>}
      </p>
      <h1 class="title display">{post.data.title}</h1>
      {
        post.data.description && <p class="desc">{post.data.description}</p>
      }
      <div class="tags">
        {post.data.tags.map((t) => (
          <span class="chip">{t}</span>
        ))}
      </div>
    </header>

    <hr class="rule" />

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-top: 70px;
    max-width: 860px;
  }

  .back {
    display: inline-block;
    margin-bottom: 40px;
  }

  .back:hover {
    color: var(--accent);
  }

  .head {
    margin-bottom: 36px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .title {
    font-size: clamp(30px, 4.6vw, 48px);
    margin-bottom: 18px;
  }

  .desc {
    font-size: 17px;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rule {
    margin: 26px 0 40px;
  }
</style>
