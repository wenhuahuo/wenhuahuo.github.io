---
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo display">
      {SITE.logo}<span class="logo-dot">·</span>
    </a>

    <nav class="nav">
      {
        NAV.map((item, i) => (
          <>
            {i > 0 && <span class="nav-sep">/</span>}
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          </>
        ))
      }
    </nav>

    <div class="header-cta">
      <a href={SITE.contact.github} target="_blank" rel="noopener" class="btn-mini btn-mini-solid"
        >● GITHUB</a
      >
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-h);
    background: rgba(240, 237, 230, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
    z-index: 100;
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-size: 26px;
    font-weight: 700;
  }

  .logo-dot {
    color: var(--accent);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
    margin-right: 32px;
  }

  .nav-sep {
    color: var(--line-strong);
    font-size: 12px;
  }

  .nav-link {
    font-size: 15px;
    padding: 4px 2px;
    position: relative;
    color: var(--ink);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -4px;
    height: 2px;
    background: var(--accent);
    transition: right 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    right: 0;
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-mini {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    padding: 7px 14px;
    transition: all 0.2s ease;
    background: var(--ink);
    color: var(--bg);
  }

  .btn-mini-solid:hover {
    background: var(--accent);
  }

  @media (max-width: 860px) {
    .nav {
      margin-right: 12px;
      gap: 8px;
    }

    .header-cta {
      display: none;
    }
  }
</style>
